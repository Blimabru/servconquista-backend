# ==============================================================================
# CONFIGURAÇÕES DO BACKEND (API)
# ==============================================================================

# 1. Aplicação
NODE_ENV=development
APP_NAME=conquistaserv-backend
APP_VERSION=1.0.0
HTTP_PORT=3006
APP_HOSTNAME=localhost
FRONTEND_URLS=http://localhost:8080,https://hml-servconquista.brainstormlabs.online,https://servconquista.brainstormlabs.online
SSL=false

# 2. Banco de Dados (PostgreSQL)
# Conecte usando suas credenciais (bruno, heder, iasmin, katarine, lucas):
DATABASE_URL="postgresql://SEU_USUARIO:SUA_SENHA@163.176.5.66:5432/hml-conquistaserv?schema=conquistaserv"

# 3. Autenticação (JWT)
ACCESS_TOKEN_SECRET=sua_chave_jwt_secreta_aqui
ACCESS_TOKEN_EXPIRATION=86400s
REFRESH_TOKEN_SECRET=sua_chave_jwt_refresh_aqui
REFRESH_TOKEN_EXPIRATION=604800s

# 4. Inteligência Artificial (OpenAI)
OPENAI_API_KEY=sua_chave_openai_aqui
AI_MODEL_NAME=gpt-4o-mini
AI_TEMPERATURE=0
AI_CHUNK_SIZE=1000
AI_CHUNK_OVERLAP=200
AI_DOCS_PATH=./docs/training
AI_SYSTEM_PROMPT_PATH=./docs/prompts/system-prompt.md

# 5. Logs (Elasticsearch - Opcional)
ELASTICSEARCH_ACTIVE=false
ELASTICSEARCH=http://localhost:9200
