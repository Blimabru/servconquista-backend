# ==============================================================================
#                      CONQUISTASERV - BACKEND (API)
#                           TEMPLATE DE CONFIGURAÇÃO
# ==============================================================================
# Instruções:
# 1. Copie este arquivo para '.env':
#    cp .env.example .env
# 2. Descomente e preencha as variáveis de acordo com o seu ambiente de trabalho.
#
# AVISO DE SEGURANÇA:
# NUNCA commite senhas reais, chaves JWT ou tokens de API neste arquivo de exemplo.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AMBIENTE E SERVIDOR HTTP
# ------------------------------------------------------------------------------
# NODE_ENV: 'development' para máquina local, 'production' para servidor.
NODE_ENV=development

# APP_NAME: Identificador único do serviço.
APP_NAME=conquistaserv-backend

# APP_VERSION: Versão semântica alinhada ao package.json.
APP_VERSION=1.0.0

# HTTP_PORT: Porta TCP onde a API NestJS escutará requisições locais.
HTTP_PORT=3006

# APP_HOSTNAME: Host ou domínio pelo qual a API é referenciada.
# - Local: localhost
# - Homologação: hml-servconquista.brainstormlabs.online
# - Produção: servconquista.brainstormlabs.online
APP_HOSTNAME=localhost

# FRONTEND_URLS: Origens autorizadas para CORS (separadas por vírgula).
FRONTEND_URLS=http://localhost:8080,https://hml-servconquista.brainstormlabs.online,https://servconquista.brainstormlabs.online

# SSL: Habilita SSL nativo no Node.js. Manter 'false' quando utilizar Proxy Reverso (NPM/Nginx).
SSL=false


# ------------------------------------------------------------------------------
# 2. PERSISTÊNCIA DE DADOS (POSTGRESQL & PRISMA ORM)
# ------------------------------------------------------------------------------
# Formato padrão:
# postgresql://<USUARIO>:<SENHA>@<HOST>:<PORTA>/<BANCO>?schema=conquistaserv
#
# Observação sobre schemas:
# O projeto utiliza o schema 'conquistaserv'. Mantenha '?schema=conquistaserv' no final.
#
# ------------------------------------------------------------------------------
# PRESET A: Desenvolvimento Local (Conectando ao banco de Homologação / Teste)
# Cada desenvolvedor deve utilizar suas credenciais individuais criadas no Postgres:
# Usuários disponíveis: bruno, heder, iasmin, katarine, lucas
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://SEU_USUARIO:SUA_SENHA@163.176.5.66:5432/hml-conquistaserv?schema=conquistaserv"

# ------------------------------------------------------------------------------
# PRESET B: Desenvolvimento Local (Conectando a um Postgres rodando localmente)
# ------------------------------------------------------------------------------
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/conquistaserv?schema=conquistaserv"

# ------------------------------------------------------------------------------
# PRESET C: Servidor - Homologação (Configurado automaticamente via Secrets no GitHub)
# ------------------------------------------------------------------------------
# DATABASE_URL="postgresql://user_conquistaserv:SUA_SENHA@postgres:5432/hml-conquistaserv?schema=conquistaserv"

# ------------------------------------------------------------------------------
# PRESET D: Servidor - Produção (Configurado automaticamente via Secrets no GitHub)
# ------------------------------------------------------------------------------
# DATABASE_URL="postgresql://user_conquistaserv:SUA_SENHA@postgres:5432/conquistaserv?schema=conquistaserv"


# ------------------------------------------------------------------------------
# 3. SEGURANÇA E AUTENTICAÇÃO (JWT - JSON WEB TOKEN)
# ------------------------------------------------------------------------------
# Chaves criptográficas para assinatura e validação dos tokens de acesso e refresh.
ACCESS_TOKEN_SECRET=sua_chave_jwt_secreta_aqui
ACCESS_TOKEN_EXPIRATION=86400s

REFRESH_TOKEN_SECRET=sua_chave_jwt_refresh_aqui
REFRESH_TOKEN_EXPIRATION=604800s


# ------------------------------------------------------------------------------
# 4. INTELIGÊNCIA ARTIFICIAL (OPENAI & RAG / LANGCHAIN)
# ------------------------------------------------------------------------------
# OPENAI_API_KEY: Chave secreta da API da OpenAI para geração e embeddings.
OPENAI_API_KEY=sua_chave_openai_aqui

# AI_MODEL_NAME: Modelo da OpenAI utilizado nos prompts e agentes.
AI_MODEL_NAME=gpt-4o-mini

# AI_TEMPERATURE: Temperatura de amostragem (0.0 mais determinístico, 1.0 mais criativo).
AI_TEMPERATURE=0

# AI_CHUNK_SIZE & OVERLAP: Parâmetros de segmentação de texto para a base de conhecimento.
AI_CHUNK_SIZE=1000
AI_CHUNK_OVERLAP=200

# Caminhos dos documentos de treinamento e prompt mestre do sistema.
AI_DOCS_PATH=./docs/training
AI_SYSTEM_PROMPT_PATH=./docs/prompts/system-prompt.md


# ------------------------------------------------------------------------------
# 5. TELEMETRIA E CENTRALIZAÇÃO DE LOGS (ELASTICSEARCH - OPCIONAL)
# ------------------------------------------------------------------------------
ELASTICSEARCH_ACTIVE=false
ELASTICSEARCH=http://localhost:9200
